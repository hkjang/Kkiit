POSTGRES_DSN=postgres://kkiit:change-me@postgres.internal:5432/kkiit?sslmode=require
BOOTSTRAP_ADMIN=admin@example.internal
BOOTSTRAP_ADMIN_PASSWORD=replace-with-at-least-12-characters
ENCRYPTION_KEY=replace-with-32-byte-base64-or-64-character-hex

# 선택: 종료 전 사전 drain 대기 시간(초), 기본 5, 정수 0~120(양 끝 포함).
# 미지정·빈 값·정수가 아닌 값·범위 밖 값이면 기본 5초를 사용합니다.
# 0은 사전 drain 대기만 생략하며, 진행 중 요청과 이벤트 디스패처의 종료 대기는 유지합니다.
# SHUTDOWN_DRAIN_SECONDS=5
